{
  "Agent": {
    "Model": "claude-opus-5-5",
    "MaxTurns": 10,
    "MaxMessageChars": 4000,
    "AllowWriteTools": false
  },
  "Anthropic": {
    "ApiKey": "[SET_ON_SERVER_ONLY]"
  },
  "Mcp": {
    "Endpoint": "https://[MCP_HOST]/mcp"
  },
  "Cors": {
    "AllowedOrigins": [ "https://[CHAT_HOST]" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "PersonalAgent": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
